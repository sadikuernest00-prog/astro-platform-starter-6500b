---
import { createClient } from '@supabase/supabase-js'

const supabase = createClient(
  'https://fvrmcoukkczweuneyovf.supabase.co',
  'sb_publishable_bZL-upuSb3I35MVMTciL9w_HolwKJQt'
)

let message = ''

if (Astro.request.method === 'POST') {

  const formData = await Astro.request.formData()

  const action = formData.get('action')
  const email = formData.get('email')
  const password = formData.get('password')

  if (action === 'register') {

    const { error } = await supabase.auth.signUp({
      email,
      password,
    })

    if (error) {
      message = error.message
    } else {
      message = 'Account created successfully!'
    }
  }

  if (action === 'login') {

    const { error } = await supabase.auth.signInWithPassword({
      email,
      password,
    })

    if (error) {
      message = error.message
    } else {
      message = 'Login successful!'
    }
  }
}
---

<html lang="en">

<head>

<meta charset="UTF-8" />

<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>Amicbridge</title>

<style>

body{
  margin:0;
  background:#020b2d;
  color:white;
  font-family:Arial;
}

.navbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:30px 60px;
  border-bottom:1px solid rgba(255,255,255,0.1);
}

.logo{
  font-size:40px;
  font-weight:bold;
}

.logo span{
  color:orange;
}

.wallet{
  background:orange;
  color:white;
  border:none;
  padding:15px 25px;
  border-radius:12px;
  font-size:18px;
  cursor:pointer;
}

.hero{
  max-width:1300px;
  margin:auto;
  padding:80px 30px;
  display:grid;
  grid-template-columns:1fr 450px;
  gap:40px;
}

.left h1{
  font-size:80px;
  line-height:1;
  margin-bottom:30px;
}

.left p{
  font-size:24px;
  color:#b0bdd7;
  line-height:1.5;
}

.card{
  background:#08153d;
  padding:35px;
  border-radius:25px;
}

.card h2{
  font-size:36px;
  margin-bottom:25px;
}

input{
  width:100%;
  padding:20px;
  margin-bottom:20px;
  border:none;
  border-radius:12px;
  font-size:20px;
  background:#13214d;
  color:white;
}

.buttons{
  display:flex;
  gap:15px;
}

button{
  flex:1;
  padding:18px;
  border:none;
  border-radius:12px;
  font-size:20px;
  cursor:pointer;
}

.register{
  background:orange;
  color:white;
}

.login{
  background:#00c853;
  color:white;
}

.message{
  margin-top:20px;
  font-size:18px;
}

.matches{
  max-width:1300px;
  margin:auto;
  padding:0 30px 80px;
}

.matches h2{
  font-size:40px;
  margin-bottom:30px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
  gap:25px;
}

.match{
  background:#08153d;
  padding:25px;
  border-radius:25px;
}

.league{
  color:orange;
  margin-bottom:15px;
  font-size:14px;
  text-transform:uppercase;
}

.teams{
  font-size:32px;
  font-weight:bold;
  margin-bottom:25px;
}

.odds{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
}

.odds button{
  background:#13214d;
  color:white;
}

@media(max-width:900px){

.hero{
  grid-template-columns:1fr;
}

.left h1{
  font-size:55px;
}

.navbar{
  padding:25px;
}

}

</style>

</head>

<body>

<div class="navbar">

<div class="logo">
<span>●</span> Amicbridge
</div>

<button class="wallet">
Connect Wallet
</button>

</div>

