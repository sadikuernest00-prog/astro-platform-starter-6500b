---
import { createClient } from '@supabase/supabase-js'

const supabase = createClient(
  'https://fvrmcoukkczweuneyovf.supabase.co',
  'sb_publishable_bZL-upuSb3I35MVMTciL9w_HolwKJQt'
)

let message = ''

if (Astro.request.method === 'POST') {

  const formData = await Astro.request.formData()

  const action = formData.get('action')
  const email = formData.get('email')
  const password = formData.get('password')

  if (action === 'register') {

    const { error } = await supabase.auth.signUp({
      email,
      password,
    })

    if (error) {
      message = error.message
    } else {
      message = 'Registration successful!'
    }
  }

  if (action === 'login') {

    const { error } = await supabase.auth.signInWithPassword({
      email,
      password,
    })

    if (error) {
      message = error.message
    } else {
      message = 'Login successful!'
    }
  }
}
---

<html>

<head>

<title>Amicbridge</title>

<style>

body{
  margin:0;
  background:#020b2d;
  font-family:Arial;
  color:white;
}

.nav{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:25px 50px;
  border-bottom:1px solid rgba(255,255,255,0.1);
}

.logo{
  font-size:42px;
  font-weight:bold;
}

.logo span{
  color:orange;
}

.wallet{
  background:orange;
  border:none;
  color:white;
  padding:15px 30px;
  border-radius:12px;
  font-size:18px;
}

.container{
  max-width:1300px;
  margin:auto;
  padding:80px 30px;
  display:grid;
  grid-template-columns:1fr 500px;
  gap:50px;
}

.left h1{
  font-size:90px;
  line-height:1;
}

.left p{
  color:#b0bdd7;
  font-size:28px;
  line-height:1.5;
}

.card{
  background:#08153d;
  padding:40px;
  border-radius:30px;
}

.card h2{
  font-size:50px;
  margin-bottom:30px;
}

input{
  width:100%;
  padding:22px;
  margin-bottom:20px;
  border:none;
  border-radius:15px;
  background:#13214d;
  color:white;
  font-size:22px;
  box-sizing:border-box;
}

.buttons{
  display:flex;
  gap:20px;
}

button{
  flex:1;
  padding:20px;
  border:none;
  border-radius:15px;
  font-size:24px;
  cursor:pointer;
}

.register{
  background:orange;
  color:white;
}

.login{
  background:#00c853;
  color:white;
}

.message{
  margin-top:25px;
  background:#13214d;
  padding:18px;
  border-radius:12px;
  font-size:18px;
}

.matches{
  max-width:1300px;
  margin:auto;
  padding:0 30px 80px;
}

.matches h2{
  font-size:50px;
  margin-bottom:30px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
  gap:25px;
}

.match{
  background:#08153d;
  padding:30px;
  border-radius:25px;
}

.league{
  color:orange;
  margin-bottom:15px;
}

.teams{
  font-size:34px;
  font-weight:bold;
  margin-bottom:20px;
}

.odds{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
}

.odds button{
  background:#13214d;
  color:white;
  font-size:18px;
}

@media(max-width:900px){

.container{
  grid-template-columns:1fr;
}

.left h1{
  font-size:60px;
}

}

</style>

</head>

<body>

<div class="nav">

<div class="logo">
<span>●</span> Amicbridge
</div>

<button class="wallet">
Connect Wallet
</button>

</div>

<div class="container">

<div class="left">

<h1>
Crypto Sports Betting
</h1>

<p>
Bet on live sports using crypto technology,
fast payouts and secure authentication.
</p>

</div>

