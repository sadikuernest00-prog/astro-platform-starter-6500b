---
const response = await fetch('https://amicbridge.com/api/matches')
const data = await response.json()

const matches = data.response || []
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Amicbridge Live Betting</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #020b2d;
      color: white;
      font-family: Arial, sans-serif;
    }

    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 25px 50px;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      background: #05113b;
    }

    .logo {
      font-size: 42px;
      font-weight: bold;
      color: orange;
    }

    .wallet-btn {
      background: orange;
      border: none;
      padding: 15px 30px;
      border-radius: 14px;
      color: white;
      font-size: 18px;
      font-weight: bold;
      cursor: pointer;
    }

    .hero {
      padding: 80px 50px 40px;
    }

    .hero h1 {
      font-size: 80px;
      line-height: 1;
      margin-bottom: 20px;
    }

    .hero p {
      color: #b6bdd3;
      font-size: 24px;
      max-width: 700px;
      line-height: 1.5;
    }

    .matches-container {
      padding: 30px 50px 80px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
      gap: 25px;
    }

    .match-card {
      background: #081544;
      border-radius: 22px;
      padding: 25px;
      transition: 0.2s;
      box-shadow: 0 0 25px rgba(0,0,0,0.35);
    }

    .match-card:hover {
      transform: translateY(-3px);
    }

    .league {
      color: orange;
      font-size: 14px;
      margin-bottom: 14px;
      font-weight: bold;
    }

    .teams {
      font-size: 28px;
      font-weight: bold;
      margin-bottom: 16px;
      line-height: 1.3;
    }

    .live {
      color: #00ff88;
      font-weight: bold;
      margin-bottom: 12px;
      font-size: 18px;
    }

    .score {
      font-size: 34px;
      margin-bottom: 25px;
      font-weight: bold;
    }

    .bet-buttons {
      display: flex;
      gap: 12px;
    }

    .bet-buttons button {
      flex: 1;
      padding: 15px;
      border: none;
      border-radius: 12px;
      background: orange;
      color: white;
      font-size: 18px;
      font-weight: bold;
      cursor: pointer;
      transition: 0.2s;
    }

    .bet-buttons button:hover {
      opacity: 0.85;
    }

    .empty {
      padding: 60px;
      font-size: 26px;
      color: #b6bdd3;
    }

    @media (max-width: 768px) {
      .hero h1 {
        font-size: 52px;
      }

      .navbar {
        flex-direction: column;
        gap: 20px;
      }

      .matches-container {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

  <div class="navbar">
    <div class="logo">
      ⚽ Amicbridge
    </div>

    <button class="wallet-btn">
      Connect Wallet
    </button>
  </div>

  <div class="hero">
    <h1>
      Crypto Sports Betting
    </h1>

    <p>
      Live football matches powered by API-Football with real-time scores,
      live fixtures and future crypto betting integration.
    </p>
  </div>

  {
    matches.length > 0 ? (

      <div class="matches-container">

        {matches.map((match) => (

          <div class="match-card">

            <div class="league">
              {match.league.name}
            </div>

            <div class="teams">
              {match.teams.home.name}
              <br />
              vs
              <br />
              {match.teams.away.name}
            </div>

            <div class="live">
              LIVE • {match.fixture.status.elapsed}'
            </div>

            <div class="score">
              {match.goals.home} - {match.goals.away}
            </div>

            <div class="bet-buttons">
              <button>Home</button>
              <button>Draw</button>
              <button>Away</button>
            </div>

          </div>

        ))}

      </div>

    ) : (

      <div class="empty">
        No live football matches right now ⚽
      </div>

    )
  }

</body>
</html>
