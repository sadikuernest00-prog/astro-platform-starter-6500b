---
const API_KEY = "82c608c837000113d5867bd11f243454";

let matches = [];

try {

  const response = await fetch(
    "https://v3.football.api-sports.io/fixtures?next=10",
    {
      method: "GET",
      headers: {
        "x-apisports-key": API_KEY
      }
    }
  );

  const data = await response.json();

  matches = data.response || [];

} catch (err) {
  console.log(err);
}
---

<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<title>Amicbridge</title>

<style>

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:Arial,sans-serif;
}

body{
  background:#020b3d;
  color:white;
}

header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:25px 40px;
  border-bottom:1px solid rgba(255,255,255,0.1);
}

.logo{
  font-size:52px;
  font-weight:bold;
  color:#ffb000;
}

.wallet-btn{
  background:#ffb000;
  border:none;
  padding:18px 40px;
  border-radius:15px;
  font-size:24px;
  color:white;
  font-weight:bold;
  cursor:pointer;
}

.hero{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:60px;
  padding:60px;
}

.left{
  flex:1;
}

.left h1{
  font-size:110px;
  line-height:0.9;
  margin-bottom:30px;
}

.left p{
  font-size:30px;
  line-height:1.5;
  color:#c7d0ff;
  max-width:700px;
}

.right{
  width:520px;
  background:#0c1657;
  padding:40px;
  border-radius:30px;
}

.right h2{
  font-size:56px;
  margin-bottom:30px;
}

.input{
  width:100%;
  padding:24px;
  margin-bottom:25px;
  border:none;
  border-radius:16px;
  background:#18256f;
  color:white;
  font-size:24px;
}

.buttons{
  display:flex;
  gap:20px;
}

.register{
  flex:1;
  background:#ffb000;
  border:none;
  padding:22px;
  border-radius:16px;
  font-size:26px;
  color:white;
  font-weight:bold;
  cursor:pointer;
}

.login{
  flex:1;
  background:#00d84f;
  border:none;
  padding:22px;
  border-radius:16px;
  font-size:26px;
  color:white;
  font-weight:bold;
  cursor:pointer;
}

.message{
  margin-top:20px;
  color:#00ff95;
  font-size:22px;
}

.matches{
  padding:60px;
}

.matches h2{
  font-size:60px;
  margin-bottom:40px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
  gap:30px;
}

.card{
  background:#0c1657;
  padding:30px;
  border-radius:25px;
}

.league{
  color:#a7b5ff;
  margin-bottom:15px;
  font-size:18px;
}

.teams{
  font-size:34px;
  font-weight:bold;
  margin-bottom:20px;
  line-height:1.3;
}

.live{
  color:#00ff88;
  font-size:20px;
  margin-bottom:20px;
}

.date{
  color:#c7d0ff;
  margin-bottom:20px;
  font-size:18px;
}

.odds{
  display:flex;
  gap:15px;
}

.odd{
  flex:1;
  background:#18256f;
  padding:18px;
  border-radius:15px;
  text-align:center;
  font-size:22px;
  font-weight:bold;
}

</style>
</head>

<body>

<header>

<div class="logo">
⚽ Amicbridge
</div>

<button class="wallet-btn">
Connect Wallet
</button>

</header>

<section class="hero">

<div class="left">

<h1>
Crypto<br/>
Sports<br/>
Betting
</h1>

<p>
Bet on real football matches using modern crypto technology,
secure authentication and real-time football data.
</p>

</div>

<div class="right">

<h2>Login or Register</h2>

<input
id="email"
class="input"
type="email"
placeholder="Email"
/>

<input
id="password"
class="input"
type="password"
placeholder="Password"
/>

<div class="buttons">

<button
class="register"
onclick="registerUser()"
>
Register
</button>

<button
class="login"
onclick="loginUser()"
>
Login
</button>

</div>

<div id="message" class="message"></div>

</div>

</section>

<section class="matches">

<h2>🔥 Upcoming Football Matches</h2>

<div class="grid">

{
matches.length > 0 ? (

matches.map((match) => (

<div class="card">

<div class="league">
{match.league.name}
</div>

<div class="teams">
{match.teams.home.name}
<br/>
vs
<br/>
{match.teams.away.name}
</div>

<div class="date">
{new Date(match.fixture.date).toLocaleString()}
</div>

<div class="live">
{match.fixture.status.long}
</div>

<div class="odds">

<div class="odd">
HOME
</div>

<div class="odd">
DRAW
</div>

<div class="odd">
AWAY
</div>

</div>

</div>

))

) : (

<div class="card">

<div class="teams">
No matches available
</div>

</div>

)
}

</div>

</section>

<script type="module">

import { createClient }
from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm'

const supabaseUrl =
'https://YOUR_PROJECT.supabase.co'

const supabaseKey =
'YOUR_SUPABASE_ANON_KEY'

const supabase =
createClient(supabaseUrl, supabaseKey)

async function registerUser(){

const email =
document.getElementById('email').value

const password =
document.getElementById('password').value

const message =
document.getElementById('message')

const { error } =
await supabase.auth.signUp({
email,
password
})

if(error){

message.innerText =
error.message

}else{

message.innerText =
'Registration successful!'

}

}

async function loginUser(){

const email =
document.getElementById('email').value

const password =
document.getElementById('password').value

const message =
document.getElementById('message')

const { error } =
await supabase.auth.signInWithPassword({
email,
password
})

if(error){

message.innerText =
error.message

}else{

message.innerText =
'Login successful!'

}

}

window.registerUser = registerUser
window.loginUser = loginUser

</script>

</body>
</html>
