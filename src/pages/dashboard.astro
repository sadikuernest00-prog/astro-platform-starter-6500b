---
import DashboardUser from "../components/DashboardUser";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1"
		/>
		<meta
			name="description"
			content="Amic financial dashboard."
		/>
		<title>Dashboard | Amic</title>
	</head>

	<body>
		<header>
			<a class="logo" href="/dashboard">Amic</a>

			<div class="avatar">A</div>
		</header>

		<main>
			<DashboardUser client:load />

			<section class="welcome">
				<p>Welcome to</p>
				<h1>Amic</h1>
			</section>

			<section class="balance-card">
				<p>Total balance</p>
				<h2>€12,450.25</h2>
			</section>

			<section class="actions">
				<button type="button">
					<span class="action-icon">＋</span>
					<span>Add money</span>
				</button>

				<button type="button">
					<span class="action-icon">↑</span>
					<span>Send</span>
				</button>

				<button type="button">
					<span class="action-icon">⇄</span>
					<span>Exchange</span>
				</button>

				<button type="button">
					<span class="action-icon">•••</span>
					<span>More</span>
				</button>
			</section>

			<section class="dashboard-section">
				<div class="section-title">
					<h2>Accounts</h2>
					<a href="#">See all</a>
				</div>

				<div class="account-list">
					<article class="account-row">
						<div class="account-icon">€</div>

						<div class="account-details">
							<h3>Euro account</h3>
							<p>Primary account</p>
						</div>

						<div class="account-amount">
							<strong>€8,250.25</strong>
							<span>EUR</span>
						</div>
					</article>

					<article class="account-row">
						<div class="account-icon">S</div>

						<div class="account-details">
							<h3>Savings</h3>
							<p>Emergency fund</p>
						</div>

						<div class="account-amount">
							<strong>€3,200.00</strong>
							<span>Savings</span>
						</div>
					</article>

					<article class="account-row">
						<div class="account-icon">↗</div>

						<div class="account-details">
							<h3>Investments</h3>
							<p>Portfolio</p>
						</div>

						<div class="account-amount">
							<strong>€1,000.00</strong>
							<span class="positive">+4.2%</span>
						</div>
					</article>
				</div>
			</section>

			<section class="dashboard-section">
				<div class="section-title">
					<h2>Recent activity</h2>
					<a href="#">See all</a>
				</div>

				<div class="account-list">
					<article class="account-row">
						<div class="account-icon">↓</div>

						<div class="account-details">
							<h3>Money added</h3>
							<p>Today</p>
						</div>

						<strong class="positive">+€500.00</strong>
					</article>

					<article class="account-row">
						<div class="account-icon">₿</div>

						<div class="account-details">
							<h3>Bitcoin investment</h3>
							<p>Yesterday</p>
						</div>

						<strong>-€150.00</strong>
					</article>

					<article class="account-row">
						<div class="account-icon">S</div>

						<div class="account-details">
							<h3>Savings transfer</h3>
							<p>Monday</p>
						</div>

						<strong>-€200.00</strong>
					</article>
				</div>
			</section>
		</main>

		<nav class="bottom-nav">
			<a class="active" href="/dashboard">
				<span>⌂</span>
				<span>Home</span>
			</a>

			<a href="#">
				<span>▥</span>
				<span>Invest</span>
			</a>

			<a href="#">
				<span>↔</span>
				<span>Payments</span>
			</a>

			<a href="#">
				<span>○</span>
				<span>Profile</span>
			</a>
		</nav>
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}

	html {
		font-family:
			Inter, Arial, Helvetica, sans-serif;
		background: #f4f5f7;
		color: #111827;
	}

	body {
		margin: 0;
		min-width: 320px;
		padding-bottom: 100px;
	}

	button,
	a {
		font: inherit;
	}

	header {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 18px 24px;
		background: rgba(244, 245, 247, 0.92);
		backdrop-filter: blur(18px);
	}

	.logo {
		color: #111827;
		font-size: 30px;
		font-weight: 800;
		letter-spacing: -2px;
		text-decoration: none;
	}

	.avatar {
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		background: #111827;
		color: white;
		font-weight: 800;
	}

	main {
		width: min(720px, 100%);
		margin: 0 auto;
		padding: 24px 20px 40px;
	}

	.user-area {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		margin-bottom: 28px;
		padding: 18px 20px;
		background: white;
		border-radius: 20px;
		box-shadow: 0 8px 24px rgba(17, 24, 39, 0.04);
	}

	.user-area p {
		margin: 0;
	}

	.signed-in-label {
		margin-bottom: 5px !important;
		color: #8a94a5;
		font-size: 12px;
	}

	.user-area strong {
		font-size: 14px;
		word-break: break-word;
	}

	.user-area button {
		flex: 0 0 auto;
		border: 0;
		border-radius: 12px;
		padding: 11px 16px;
		background: #eef1f5;
		color: #111827;
		font-weight: 700;
		cursor: pointer;
	}

	.welcome {
		margin-bottom: 24px;
	}

	.welcome p {
		margin: 0 0 4px;
		color: #7c8799;
	}

	.welcome h1 {
		margin: 0;
		font-size: 40px;
		letter-spacing: -2px;
	}

	.balance-card {
		padding: 30px;
		border-radius: 28px;
		background: #111827;
		color: white;
		box-shadow: 0 20px 45px rgba(17, 24, 39, 0.18);
	}

	.balance-card p {
		margin: 0 0 10px;
		color: #c4ccda;
		font-size: 15px;
	}

	.balance-card h2 {
		margin: 0;
		font-size: clamp(40px, 8vw, 54px);
		letter-spacing: -2.5px;
	}

	.actions {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 12px;
		margin: 24px 0 38px;
	}

	.actions button {
		min-height: 88px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 8px;
		border: 0;
		border-radius: 20px;
		background: white;
		color: #111827;
		font-size: 12px;
		font-weight: 700;
		cursor: pointer;
		box-shadow: 0 8px 22px rgba(17, 24, 39, 0.05);
	}

	.action-icon {
		font-size: 24px;
		font-weight: 500;
	}

	.dashboard-section {
		margin-bottom: 34px;
	}

	.section-title {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 14px;
	}

	.section-title h2 {
		margin: 0;
		font-size: 22px;
		letter-spacing: -0.8px;
	}

	.section-title a {
		color: #7c8799;
		font-size: 13px;
		font-weight: 700;
		text-decoration: none;
	}

	.account-list {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.account-row {
		display: flex;
		align-items: center;
		padding: 16px;
		border-radius: 20px;
		background: white;
		box-shadow: 0 8px 24px rgba(17, 24, 39, 0.04);
	}

	.account-icon {
		flex: 0 0 auto;
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 16px;
		background: #eef1f5;
		font-weight: 800;
	}

	.account-details {
		flex: 1;
		min-width: 0;
		margin-left: 14px;
	}

	.account-details h3 {
		margin: 0 0 4px;
		font-size: 16px;
	}

	.account-details p {
		margin: 0;
		color: #8a94a5;
		font-size: 13px;
	}

	.account-amount {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 3px;
		margin-left: 12px;
	}

	.account-amount strong {
		font-size: 15px;
	}

	.account-amount span {
		color: #8a94a5;
		font-size: 12px;
	}

	.positive {
		color: #12805c !important;
	}

	.bottom-nav {
		position: fixed;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 30;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		padding: 12px 16px 22px;
		background: rgba(255, 255, 255, 0.94);
		border-top: 1px solid #e7eaf0;
		backdrop-filter: blur(18px);
	}

	.bottom-nav a {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 5px;
		color: #8a94a5;
		font-size: 12px;
		font-weight: 700;
		text-decoration: none;
	}

	.bottom-nav a span:first-child {
		font-size: 21px;
	}

	.bottom-nav a.active {
		color: #111827;
	}

	@media (min-width: 900px) {
		body {
			padding-bottom: 120px;
		}

		.bottom-nav {
			width: 520px;
			right: auto;
			left: 50%;
			bottom: 18px;
			transform: translateX(-50%);
			border: 1px solid #e7eaf0;
			border-radius: 24px;
			padding: 12px 18px;
			box-shadow: 0 15px 40px rgba(17, 24, 39, 0.12);
		}
	}

	@media (max-width: 520px) {
		header {
			padding: 16px 18px;
		}

		main {
			padding: 18px 16px 35px;
		}

		.user-area {
			align-items: flex-start;
			flex-direction: column;
		}

		.user-area button {
			width: 100%;
		}

		.balance-card {
			padding: 24px 20px;
		}

		.actions {
			gap: 7px;
		}

		.actions button {
			min-height: 80px;
		}

		.account-row strong {
			font-size: 14px;
		}
	}
</style>
