<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Sign in | Amic</title>
	</head>

	<body>
		<main class="page">
			<section class="login-card">
				<a class="back-link" href="/">← Back</a>

				<h1>Welcome to Amic</h1>
				<p>Sign in to view your financial dashboard.</p>

				<form id="login-form">
					<label for="email">Email</label>
					<input
						id="email"
						name="email"
						type="email"
						placeholder="you@example.com"
						required
					/>

					<label for="password">Password</label>
					<input
						id="password"
						name="password"
						type="password"
						placeholder="Enter your password"
						minlength="6"
						required
					/>

					<button type="submit">Sign in</button>
				</form>

				<div class="divider">
					<span>or</span>
				</div>

				<button id="create-account" class="secondary-button">
					Create account
				</button>

				<p id="message" class="message"></p>
			</section>
		</main>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		font-family:
			Inter, Arial, Helvetica, sans-serif;
		background: #f1f4f9;
		color: #101827;
	}

	.page {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 25px;
	}

	.login-card {
		width: 100%;
		max-width: 470px;
		background: white;
		border-radius: 32px;
		padding: 42px;
		box-shadow: 0 25px 60px rgba(15, 23, 42, 0.12);
	}

	.back-link {
		color: #71809a;
		text-decoration: none;
	}

	h1 {
		margin: 35px 0 10px;
		font-size: 36px;
		letter-spacing: -1.5px;
	}

	p {
		color: #71809a;
		line-height: 1.5;
	}

	form {
		display: flex;
		flex-direction: column;
		margin-top: 32px;
	}

	label {
		margin: 16px 0 8px;
		font-weight: 700;
	}

	input {
		width: 100%;
		padding: 16px;
		border: 1px solid #d7deea;
		border-radius: 14px;
		font-size: 16px;
		outline: none;
	}

	input:focus {
		border-color: #101827;
	}

	button {
		margin-top: 25px;
		padding: 17px;
		border: 0;
		border-radius: 14px;
		background: #101827;
		color: white;
		font-size: 17px;
		font-weight: 700;
		cursor: pointer;
	}

	.secondary-button {
		width: 100%;
		margin-top: 0;
		background: #e9edf4;
		color: #101827;
	}

	.divider {
		display: flex;
		align-items: center;
		gap: 14px;
		margin: 25px 0;
		color: #8a96aa;
	}

	.divider::before,
	.divider::after {
		content: "";
		flex: 1;
		height: 1px;
		background: #dfe4ec;
	}

	.message {
		min-height: 24px;
		text-align: center;
		margin-top: 20px;
	}

	@media (max-width: 520px) {
		.login-card {
			padding: 30px 22px;
			border-radius: 24px;
		}
	}
</style>
