---
import LoginForm from "../components/LoginForm";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1"
		/>
		<meta
			name="description"
			content="Sign in or create your Amic account."
		/>
		<title>Sign in | Amic</title>
	</head>

	<body>
		<main class="page">
			<section class="login-card">
				<a class="back-link" href="/">← Back</a>

				<div class="brand">Amic</div>

				<h1>Welcome to Amic</h1>

				<p class="introduction">
					Sign in to view your financial dashboard.
				</p>

				<LoginForm client:load />
			</section>
		</main>
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}

	html {
		font-family: Inter, Arial, Helvetica, sans-serif;
		background: #f1f4f9;
		color: #101827;
	}

	body {
		margin: 0;
		min-width: 320px;
	}

	button,
	input {
		font: inherit;
	}

	.page {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 25px;
	}

	.login-card {
		width: 100%;
		max-width: 470px;
		background: white;
		border-radius: 32px;
		padding: 42px;
		box-shadow: 0 25px 60px rgba(15, 23, 42, 0.12);
	}

	.back-link {
		color: #71809a;
		text-decoration: none;
		font-weight: 600;
	}

	.back-link:hover {
		color: #101827;
	}

	.brand {
		margin-top: 30px;
		font-size: 28px;
		font-weight: 800;
		letter-spacing: -1.5px;
	}

	h1 {
		margin: 22px 0 10px;
		font-size: 36px;
		letter-spacing: -1.5px;
	}

	.introduction {
		margin: 0;
		color: #71809a;
		line-height: 1.5;
	}

	.login-form form {
		display: flex;
		flex-direction: column;
		margin-top: 28px;
	}

	.login-form label {
		margin: 16px 0 8px;
		font-weight: 700;
	}

	.login-form input {
		width: 100%;
		padding: 16px;
		border: 1px solid #d7deea;
		border-radius: 14px;
		background: white;
		color: #101827;
		font-size: 16px;
		outline: none;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.login-form input:focus {
		border-color: #101827;
		box-shadow: 0 0 0 3px rgba(16, 24, 39, 0.1);
	}

	.login-form input:disabled {
		background: #f3f5f8;
		cursor: not-allowed;
	}

	.login-form button {
		width: 100%;
		margin-top: 25px;
		padding: 17px;
		border: 0;
		border-radius: 14px;
		background: #101827;
		color: white;
		font-size: 17px;
		font-weight: 700;
		cursor: pointer;
		transition:
			transform 0.2s ease,
			opacity 0.2s ease;
	}

	.login-form button:hover:not(:disabled) {
		transform: translateY(-1px);
		opacity: 0.92;
	}

	.login-form button:disabled {
		cursor: not-allowed;
		opacity: 0.65;
	}

	.login-form .secondary-button {
		margin-top: 0;
		background: #e9edf4;
		color: #101827;
	}

	.login-form .divider {
		display: flex;
		align-items: center;
		gap: 14px;
		margin: 25px 0;
		color: #8a96aa;
	}

	.login-form .divider::before,
	.login-form .divider::after {
		content: "";
		flex: 1;
		height: 1px;
		background: #dfe4ec;
	}

	.login-form .message {
		margin: 20px 0 0;
		padding: 13px;
		border-radius: 12px;
		text-align: center;
		line-height: 1.4;
	}

	.login-form .error-message {
		background: #fff0f0;
		color: #b42318;
	}

	.login-form .success-message {
		background: #ecfdf3;
		color: #067647;
	}

	@media (max-width: 520px) {
		.page {
			padding: 16px;
		}

		.login-card {
			padding: 30px 22px;
			border-radius: 24px;
		}

		h1 {
			font-size: 31px;
		}
	}
</style>
